# Copy to .env and adjust as needed. Every value below is the built-in default,
# so an empty or absent .env file is also valid.

# --- Application -------------------------------------------------------------
HBP_APP_NAME=Hospital Bulk Processing
HBP_ENVIRONMENT=local
HBP_LOG_LEVEL=INFO

# --- Upstream Hospital Directory API -----------------------------------------
HBP_HOSPITAL_API_BASE_URL=https://hospital-directory.onrender.com
# Generous by design: Render cold starts can take 30-60s on first requests.
HBP_HOSPITAL_API_TIMEOUT_SECONDS=75
HBP_HOSPITAL_API_CONNECT_TIMEOUT_SECONDS=5
HBP_HOSPITAL_API_MAX_CONCURRENCY=20
# Retries after the initial attempt; total attempts = 1 + this value.
HBP_HOSPITAL_API_MAX_RETRIES=1

# --- CSV ingestion -----------------------------------------------------------
HBP_MAX_HOSPITALS_PER_BATCH=20
HBP_MAX_CSV_SIZE_BYTES=1000000
